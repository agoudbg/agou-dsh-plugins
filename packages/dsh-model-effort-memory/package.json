{
  "name": "dsh-model-effort-memory",
  "version": "1.0.0",
  "description": "Remembers the last reasoning effort selected for each Web UI model.",
  "type": "module",
  "license": "MIT",
  "author": "agoudbg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agoudbg/agou-dsh-plugins.git",
    "directory": "packages/dsh-model-effort-memory"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "web-ui", "model", "reasoning-effort"],
  "engines": { "dsh": ">=0.2.1-rc.5" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": { "test": "node --test" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-model-selection"]
    }
  }
}
