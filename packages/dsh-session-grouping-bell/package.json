{
  "name": "dsh-session-grouping-bell",
  "version": "1.1.0",
  "description": "Quickly switch to the single-list view.",
  "type": "module",
  "license": "MIT",
  "author": "agoudbg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agoudbg/agou-dsh-plugins.git",
    "directory": "packages/dsh-session-grouping-bell"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "web-ui", "sidebar", "sessions"],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
